#!/usr/bin/env bash
#
# mac-cleanup — reclaim disk space from developer caches and stale app versions.
#
# Runs as a dry run by default: nothing is deleted without --apply.
#
#   mac-cleanup                    # show what would be freed
#   mac-cleanup --apply            # free the safe group
#   mac-cleanup --all              # dry run including the optional groups
#   mac-cleanup --all --apply -y   # everything, no confirmation
#
# Optional groups (only included with their flag, or with --all):
#   --ollama           local LLM models in ~/.ollama
#   --android-images   Android emulator system images
#   --claude-vm        Claude Desktop VM bundle
#   --bambu-beta       BambuStudio Beta data
#   --jetbrains-config config and plugins of old JetBrains versions
#   --gradle-modules   Gradle dependency jars (modules-2)
#   --sim-devices      unavailable iOS simulators
#
set -uo pipefail

APPLY=0
ASSUME_YES=0
ENABLED=""
TOTAL_BYTES=0
SUDO_NEEDED=0
MAX_LISTED=6

OPTIONAL_GROUPS="ollama android-images claude-vm bambu-beta jetbrains-config gradle-modules sim-devices"

# Deletion is confined to these prefixes. Any path outside them is refused.
SAFE_PREFIXES="$HOME/Library $HOME/.ollama $HOME/.npm $HOME/.gradle $HOME/.Trash /Library/Developer/CoreSimulator"

if [ -t 1 ]; then
    C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
    C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_RED=$'\033[31m'; C_BLUE=$'\033[34m'
else
    C_RESET=""; C_BOLD=""; C_DIM=""; C_GREEN=""; C_YELLOW=""; C_RED=""; C_BLUE=""
fi

# ------------------------------------------------------------------- helpers

die() { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
warn() { printf '  %s!%s %s\n' "$C_YELLOW" "$C_RESET" "$*"; }
note() { printf '      %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }

section() {
    printf '\n%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"
}

human() {
    awk -v b="${1:-0}" 'BEGIN {
        split("B KB MB GB TB", u, " ")
        i = 1
        while (b >= 1024 && i < 5) { b /= 1024; i++ }
        if (i == 1) printf "%d %s", b, u[i]; else printf "%.1f %s", b, u[i]
    }'
}

# Total size in bytes of whichever of the given paths exist.
bytes_of() {
    local total=0 kb p
    for p in "$@"; do
        [ -n "$p" ] || continue
        [ -e "$p" ] || continue
        kb=$(du -sk "$p" 2>/dev/null | tail -1 | awk '{print $1}')
        case "$kb" in ''|*[!0-9]*) kb=0 ;; esac
        total=$(( total + kb * 1024 ))
    done
    printf '%s' "$total"
}

enabled() {
    case " $ENABLED " in *" $1 "*) return 0 ;; esac
    return 1
}

app_running() {
    pgrep -x -q "$1" 2>/dev/null
}

is_safe_path() {
    local p="$1" pre
    case "$p" in
        ''|/|"$HOME"|"$HOME"/) return 1 ;;
        *..*) return 1 ;;
    esac
    for pre in $SAFE_PREFIXES; do
        case "$p" in "$pre"/*) return 0 ;; esac
    done
    return 1
}

# Print one task result line and add it to the running total.
report() {
    local label="$1" size="$2"
    printf '  %s%8s%s  %s\n' "$C_GREEN" "$(human "$size")" "$C_RESET" "$label"
    TOTAL_BYTES=$(( TOTAL_BYTES + size ))
}

# Delete a path already validated by is_safe_path. Content-addressed caches
# (dotslash, among others) deliberately leave their directories read-only,
# which stops rm without sudo being the issue: restore the write bit and retry.
force_rm() {
    local target="$1" parent
    parent=$(dirname "$target")

    if [ -w "$parent" ]; then
        rm -rf -- "$target" 2>/dev/null && return 0
        chmod -R u+w -- "$target" 2>/dev/null
        rm -rf -- "$target" 2>/dev/null && return 0
    fi

    sudo chmod -R u+w -- "$target" 2>/dev/null
    sudo rm -rf -- "$target" 2>/dev/null && return 0

    warn "could not delete: $target"
    return 1
}

# remove_paths <label> <path>...
remove_paths() {
    local label="$1"; shift
    local -a targets=()
    local p size parent shown=0

    for p in "$@"; do
        [ -n "$p" ] || continue
        [ -e "$p" ] || continue
        if ! is_safe_path "$p"; then
            warn "refused, outside the allowed prefixes: $p"
            continue
        fi
        targets[${#targets[@]}]="$p"
    done

    [ ${#targets[@]} -gt 0 ] || return 0

    size=$(bytes_of "${targets[@]}")
    report "$label" "$size"

    for p in "${targets[@]}"; do
        parent=$(dirname "$p")
        [ -w "$parent" ] || SUDO_NEEDED=1
        if [ "$shown" -lt "$MAX_LISTED" ]; then
            if [ -w "$parent" ]; then note "$p"; else note "$p  (sudo)"; fi
            shown=$(( shown + 1 ))
        fi
    done
    if [ ${#targets[@]} -gt "$MAX_LISTED" ]; then
        note "... and $(( ${#targets[@]} - MAX_LISTED )) more"
    fi

    [ "$APPLY" -eq 1 ] || return 0

    for p in "${targets[@]}"; do
        force_rm "$p"
    done
}

# remove_via <label> <path-to-measure> -- <command>...
remove_via() {
    local label="$1" measure="$2"; shift 2
    [ "${1:-}" = "--" ] && shift
    local size

    size=$(bytes_of "$measure")
    [ "$size" -gt 0 ] || return 0

    report "$label" "$size"
    note "\$ $*"

    [ "$APPLY" -eq 1 ] || return 0
    "$@" >/dev/null 2>&1 || warn "failed: $*"
}

# From a directory of <Product><Version> names, print the ones that are not
# the newest version of their product.
stale_versioned_dirs() {
    local dir="$1"
    [ -d "$dir" ] || return 0
    ls -1 "$dir" 2>/dev/null \
        | grep -E '^[A-Za-z]+[0-9]{4}(\.[0-9]+)*$' \
        | sed -E 's/^([A-Za-z]+)(.*)$/\1 \2/' \
        | sort -k1,1 -k2,2V \
        | awk '{ p[$1] = p[$1] " " $1 $2 }
               END { for (k in p) { n = split(p[k], v, " "); for (i = 1; i < n; i++) print v[i] } }'
}

# --------------------------------------------------------------- safe group

task_fusion() {
    local dir="$HOME/Library/Application Support/Autodesk/webdeploy/production"
    [ -d "$dir" ] || return 0

    local keep="" link target hash d
    for link in "$dir"/*.app; do
        [ -L "$link" ] || continue
        target=$(readlink "$link")
        [ -n "$target" ] || continue
        keep="$keep $(basename "$(dirname "$target")")"
    done

    if [ -z "$keep" ]; then
        warn "Fusion 360: active version symlink not found, skipped to be safe"
        return 0
    fi

    local -a stale=()
    for d in "$dir"/*; do
        [ -d "$d" ] || continue
        [ -L "$d" ] && continue
        hash=$(basename "$d")
        case "$hash" in *.app) continue ;; esac
        case " $keep " in *" $hash "*) continue ;; esac
        stale[${#stale[@]}]="$d"
    done

    [ ${#stale[@]} -gt 0 ] || return 0
    remove_paths "Fusion 360 stale versions (keeping${keep})" "${stale[@]}"
}

task_sim_runtimes() {
    command -v xcrun >/dev/null 2>&1 || return 0
    command -v jq >/dev/null 2>&1 || return 0

    local json stale id version build size used
    json=$(xcrun simctl runtime list -j 2>/dev/null) || return 0
    [ -n "$json" ] || return 0

    # Group by platform, sort by version, drop the newest one from each group.
    stale=$(printf '%s' "$json" | jq -r '
        to_entries
        | map(select(.value.deletable == true))
        | group_by(.value.platformIdentifier)
        | map(sort_by(.value.version | split(".") | map(tonumber)) | .[0:-1])
        | flatten
        | .[]
        | [.key, .value.version, .value.build, (.value.sizeBytes // 0), (.value.lastUsedAt // "never")]
        | @tsv' 2>/dev/null) || return 0

    [ -n "$stale" ] || return 0

    while IFS=$'\t' read -r id version build size used; do
        [ -n "$id" ] || continue
        report "iOS $version ($build) simulator runtime, last used $used" "$size"
        note "\$ xcrun simctl runtime delete $id"
        if [ "$APPLY" -eq 1 ]; then
            xcrun simctl runtime delete "$id" >/dev/null 2>&1 \
                || warn "failed to delete the $version runtime"
        fi
    done <<EOF
$stale
EOF
}

task_sim_dyld_cache() {
    local dir="/Library/Developer/CoreSimulator/Caches/dyld"
    [ -d "$dir" ] || return 0

    local -a children=()
    local d
    for d in "$dir"/*; do
        [ -e "$d" ] || continue
        children[${#children[@]}]="$d"
    done

    [ ${#children[@]} -gt 0 ] || return 0
    remove_paths "Simulator dyld cache, rebuilt on the next build" "${children[@]}"
}

task_jetbrains_caches() {
    local caches="$HOME/Library/Caches/JetBrains"
    local logs="$HOME/Library/Logs/JetBrains"
    local name stale_names=""

    local -a stale=()
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        stale[${#stale[@]}]="$caches/$name"
    done <<EOF
$(stale_versioned_dirs "$caches")
EOF
    [ ${#stale[@]} -gt 0 ] && remove_paths "JetBrains indexes of uninstalled versions" "${stale[@]}"

    stale=()
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        stale[${#stale[@]}]="$logs/$name"
        stale_names="$stale_names $name"
    done <<EOF
$(stale_versioned_dirs "$logs")
EOF
    [ ${#stale[@]} -gt 0 ] && remove_paths "JetBrains logs of uninstalled versions" "${stale[@]}"

    # Logs of the versions still installed: files only, keeping the folders.
    # The stale folders above are already counted, so leave them out.
    [ -d "$logs" ] || return 0
    local -a files=()
    local f dir
    while IFS= read -r f; do
        [ -n "$f" ] || continue
        dir=$(basename "$(dirname "$f")")
        case " $stale_names " in *" $dir "*) continue ;; esac
        files[${#files[@]}]="$f"
    done <<EOF
$(find "$logs" -maxdepth 2 -type f -name '*.log*' 2>/dev/null)
EOF
    [ ${#files[@]} -gt 0 ] && remove_paths "JetBrains log files of current versions" "${files[@]}"
    return 0
}

task_gradle() {
    local -a targets=()
    local d name
    [ -d "$HOME/.gradle/caches" ] || return 0

    for d in "$HOME/.gradle/caches"/*; do
        [ -e "$d" ] || continue
        name=$(basename "$d")
        # modules-2 holds the dependency jars: only with --gradle-modules.
        [ "$name" = "modules-2" ] && continue
        [ "$name" = "CACHEDIR.TAG" ] && continue
        targets[${#targets[@]}]="$d"
    done

    [ ${#targets[@]} -gt 0 ] || return 0
    remove_paths "Gradle build caches" "${targets[@]}"
}

task_dev_caches() {
    remove_paths "npm cache" "$HOME/Library/Caches/npm"
    remove_via "npm cache (_cacache)" "$HOME/.npm/_cacache" -- npm cache clean --force
    remove_via "Go build cache" "$HOME/Library/Caches/go-build" -- go clean -cache
    remove_via "Homebrew downloads" "$HOME/Library/Caches/Homebrew/downloads" -- brew cleanup -s --prune=all

    remove_paths "CocoaPods cache" "$HOME/Library/Caches/CocoaPods"
    remove_paths "Playwright browsers, restore with: npx playwright install" \
        "$HOME/Library/Caches/ms-playwright" \
        "$HOME/Library/Caches/ms-playwright-mcp"
    remove_paths "Cached Electron binaries" "$HOME/Library/Caches/electron"
    remove_paths "dotslash cache" "$HOME/Library/Caches/dotslash"
    remove_paths "Composer cache" "$HOME/Library/Caches/composer"
    remove_paths "React Native cache" "$HOME/Library/Caches/ReactNative"
    remove_paths "node-gyp cache" "$HOME/Library/Caches/node-gyp"
    remove_paths "TypeScript cache" "$HOME/Library/Caches/typescript"
    remove_paths "DBngin Sparkle updates" \
        "$HOME/Library/Caches/com.tinyapp.DBngin/org.sparkle-project.Sparkle"
    remove_paths "Bambu Studio cache" "$HOME/Library/Caches/com.bambulab.bambu-studio"
}

task_browser_caches() {
    if app_running "Brave Browser"; then
        warn "Brave is running, cache skipped (quit Brave and run again)"
    else
        remove_paths "Brave cache" "$HOME/Library/Caches/BraveSoftware"
    fi

    if app_running "Google Chrome"; then
        warn "Chrome is running, cache skipped (quit Chrome and run again)"
    else
        remove_paths "Chrome cache" "$HOME/Library/Caches/Google/Chrome"
    fi
}

task_trash() {
    local -a items=()
    local d
    for d in "$HOME/.Trash"/* "$HOME/.Trash"/.[!.]*; do
        [ -e "$d" ] || continue
        items[${#items[@]}]="$d"
    done
    [ ${#items[@]} -gt 0 ] || return 0
    remove_paths "Trash" "${items[@]}"
}

# ---------------------------------------------------------- optional groups

task_ollama() {
    enabled ollama || return 0
    local dir="$HOME/.ollama/models"
    [ -d "$dir" ] || return 0

    if command -v ollama >/dev/null 2>&1; then
        local m
        while IFS= read -r m; do
            [ -n "$m" ] && note "model: $m"
        done <<EOF
$(find "$dir/manifests" -type f 2>/dev/null | sed "s|^$dir/manifests/||")
EOF
    fi
    remove_paths "Local Ollama models, re-downloadable with ollama pull" "$dir"
}

task_android_images() {
    enabled android-images || return 0
    remove_paths "Android emulator system images" \
        "$HOME/Library/Android/sdk/system-images"
}

task_claude_vm() {
    enabled claude-vm || return 0
    if app_running "Claude"; then
        warn "Claude Desktop is running, VM bundle skipped (quit the app first)"
        return 0
    fi
    remove_paths "Claude Desktop VM bundle, recreated when needed" \
        "$HOME/Library/Application Support/Claude/vm_bundles"
    remove_paths "Claude Desktop caches" \
        "$HOME/Library/Application Support/Claude/Cache" \
        "$HOME/Library/Application Support/Claude/Code Cache" \
        "$HOME/Library/Application Support/Claude/GPUCache"
}

task_bambu_beta() {
    enabled bambu-beta || return 0
    if [ -d "/Applications/BambuStudioBeta.app" ]; then
        warn "BambuStudioBeta.app is installed, its data was kept"
        return 0
    fi
    remove_paths "BambuStudio Beta data, app no longer installed" \
        "$HOME/Library/Application Support/BambuStudioBeta"
}

task_jetbrains_config() {
    enabled jetbrains-config || return 0
    local base="$HOME/Library/Application Support/JetBrains"
    [ -d "$base" ] || return 0

    local -a stale=()
    local name
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        stale[${#stale[@]}]="$base/$name"
    done <<EOF
$(stale_versioned_dirs "$base")
EOF
    [ ${#stale[@]} -gt 0 ] || return 0
    remove_paths "JetBrains config and plugins of old versions" "${stale[@]}"
}

task_gradle_modules() {
    enabled gradle-modules || return 0
    remove_paths "Gradle dependency jars (modules-2)" "$HOME/.gradle/caches/modules-2"
}

task_sim_devices() {
    enabled sim-devices || return 0
    command -v xcrun >/dev/null 2>&1 || return 0

    local size
    size=$(bytes_of "$HOME/Library/Developer/CoreSimulator/Devices")
    [ "$size" -gt 0 ] || return 0

    report "Unavailable iOS simulators" 0
    note "\$ xcrun simctl delete unavailable"
    note "Devices holds $(human "$size") in total, only unavailable ones go"
    [ "$APPLY" -eq 1 ] && xcrun simctl delete unavailable >/dev/null 2>&1
    return 0
}

# --------------------------------------------------------------------- start

usage() {
    # The header comment block, minus the shebang, is the help text.
    awk 'NR > 2 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
    exit 0
}

while [ $# -gt 0 ]; do
    case "$1" in
        --apply) APPLY=1 ;;
        -y|--yes) ASSUME_YES=1 ;;
        --all) ENABLED="$OPTIONAL_GROUPS" ;;
        --ollama|--android-images|--claude-vm|--bambu-beta|--jetbrains-config|--gradle-modules|--sim-devices)
            ENABLED="$ENABLED ${1#--}" ;;
        -h|--help) usage ;;
        *) die "unknown option: $1 (see --help)" ;;
    esac
    shift
done

free_before=$(df -k / | awk 'NR == 2 { print $4 * 1024 }')

if [ "$APPLY" -eq 1 ]; then
    printf '%s== mac-cleanup: DELETING ==%s\n' "$C_RED$C_BOLD" "$C_RESET"
else
    printf '%s== mac-cleanup: dry run, nothing will be deleted ==%s\n' "$C_BLUE$C_BOLD" "$C_RESET"
fi
printf 'Free space now: %s\n' "$(human "$free_before")"

if [ "$APPLY" -eq 1 ] && [ "$ASSUME_YES" -eq 0 ]; then
    printf '\nRun without --apply first to review the list.\n'
    printf 'Continue and delete? [y/N] '
    read -r answer
    case "$answer" in
        y|Y|yes|YES) ;;
        *) printf 'Cancelled.\n'; exit 0 ;;
    esac
fi

section "Caches and stale versions"
task_fusion
task_sim_runtimes
task_sim_dyld_cache
task_jetbrains_caches
task_gradle
task_dev_caches
task_browser_caches
task_trash

if [ -n "$ENABLED" ]; then
    section "Optional groups:$ENABLED"
    task_ollama
    task_android_images
    task_claude_vm
    task_bambu_beta
    task_jetbrains_config
    task_gradle_modules
    task_sim_devices
fi

section "Total"
if [ "$TOTAL_BYTES" -eq 0 ]; then
    printf '  Nothing to clean.\n'
else
    if [ "$APPLY" -eq 1 ]; then
        free_after=$(df -k / | awk 'NR == 2 { print $4 * 1024 }')
        printf '  Removed: %s%s%s\n' "$C_BOLD" "$(human "$TOTAL_BYTES")" "$C_RESET"
        printf '  Free space: %s -> %s\n' "$(human "$free_before")" "$(human "$free_after")"
        printf '  %smacOS can take a few minutes to update the figure in Settings.%s\n' \
            "$C_DIM" "$C_RESET"
    else
        printf '  Would free: %s%s%s\n' "$C_BOLD" "$(human "$TOTAL_BYTES")" "$C_RESET"
        [ "$SUDO_NEEDED" -eq 1 ] && printf '  Some paths need sudo.\n'
        if [ -z "$ENABLED" ]; then
            printf '\n  Optional groups available:%s\n' " $OPTIONAL_GROUPS"
            printf '  See what they cover with: mac-cleanup --all\n'
        fi
        printf '\n  To delete: %smac-cleanup%s --apply%s\n' \
            "$C_BOLD" "${ENABLED:+ --all}" "$C_RESET"
    fi
fi
